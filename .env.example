# ==========================================
# Configuración de Entorno para n8n (P01)
# ==========================================

# Puerto local en el que correrá la interfaz web de n8n
N8N_PORT=5678

# Zona Horaria (Crucial para cron y schedule triggers en Chile)
GENERIC_TIMEZONE=America/Santiago
TZ=America/Santiago

# ==========================================
# Parámetros por Defecto para los Workflows
# ==========================================
# Ubicación por defecto: Viña del Mar, Chile
DEFAULT_LAT=-33.0245
DEFAULT_LON=-71.5518

# Umbral de lluvia (porcentaje mínimo de probabilidad para alertar)
RAIN_PROBABILITY_THRESHOLD=60

# Magnitud mínima de sismo para notificar
EARTHQUAKE_MIN_MAGNITUDE=4.0

# Radio en kilómetros para monitoreo sísmico
EARTHQUAKE_RADIUS_KM=350

# Webhook de Discord (Opcional si se prueba con Discord)
# Formato: https://discord.com/api/webhooks/ID/TOKEN
DISCORD_WEBHOOK_URL=

# Telegram Bot (Opcional si se prueba con Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
